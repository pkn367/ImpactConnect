# Copy this file to .env and fill in your own values.

# Get this connection string from MongoDB Atlas (see README for steps).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/impactconnect?retryWrites=true&w=majority

# Any long random string — used to sign login tokens. Make up your own.
JWT_SECRET=change-this-to-a-long-random-string

# Port the backend server runs on.
PORT=5000
